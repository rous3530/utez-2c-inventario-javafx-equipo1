<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox alignment="CENTER"
      spacing="25.0"
      fx:id="rootVBox"
      style="-fx-background-color: #F8F9FA; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #DCDDE1; -fx-border-width: 2;"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.integradora.Controllers.LoadController"
      prefHeight="400.0" prefWidth="600.0">

    <padding>
        <Insets bottom="20" right="20" left="20" top="20" />
    </padding>

    <ProgressIndicator fx:id="progressCircle" prefHeight="80.0" prefWidth="80.0" />
    <Label text="Cargando..." style="-fx-text-fill: #2C3E50; -fx-font-size: 20px; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: bold;" />


</VBox>
