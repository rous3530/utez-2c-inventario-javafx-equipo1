<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootContainer" style="-fx-background-color: transparent;"
           xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.integradora.Controllers.EditController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <VBox alignment="CENTER" spacing="15.0"
              style="-fx-background-color: #F8F9FA; -fx-background-radius: 20; -fx-border-radius: 20;-fx-border-width: 2; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 15, 0.5, 0, 0);">
            <children>
                <Label text="EDITAR PRODUCTO" textFill="#4169e1">
                    <font> <Font name="System Bold" size="20.0" /> </font>
                </Label>

                <VBox spacing="5.0">
                    <Label text="ID Alfanumérico (No editable):" textFill="#555555" />
                    <TextField fx:id="txtId" editable="false" style="-fx-background-color: #E9ECEF; -fx-background-radius: 7; -fx-padding: 8;" />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Nombre del Producto:" textFill="#555555" />
                    <TextField fx:id="txtNombre" style="-fx-background-radius: 7; -fx-border-radius: 7; -fx-padding: 8;" />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Costo:" textFill="#555555" />
                    <TextField fx:id="txtCosto" style="-fx-background-radius: 7; -fx-border-radius: 7; -fx-padding: 8;" />
                </VBox>

                <HBox alignment="CENTER" spacing="15.0">
                    <Button onAction="#onActualizarClick" prefWidth="110.0" text="ACTUALIZAR"
                            style="-fx-background-color: #4169E1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" />
                    <Button onAction="#onCancelarClick" prefWidth="110.0" text="CANCELAR"
                            style="-fx-background-color: #C0392B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" />
                </HBox>
            </children>
            <padding> <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" /> </padding>
        </VBox>
    </children>
</StackPane>