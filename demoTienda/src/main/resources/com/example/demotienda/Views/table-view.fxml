<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="mainContainer"
        alignment="TOP_CENTER" spacing="15" style="-fx-background-color: #F4F4F4; -fx-padding: 20;"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.integradora.Controllers.TableController">

    <Label text="Gestión de Productos" style="-fx-text-fill: #4169E1; -fx-font-size: 22; -fx-font-weight: bold;" />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtId" promptText="ID" prefWidth="60"/>
        <TextField fx:id="txtNombre" promptText="Nombre del producto" HBox.hgrow="ALWAYS"/>
        <Button text="Agregar"
                style="-fx-background-color: #4169E1; -fx-text-fill: white; -fx-font-weight: bold;" onAction="#onAgregarClick"/>
    </HBox>

    <TableView fx:id="tablaDatos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn style="-fx-alignment: CENTER;" fx:id="colId" text="ID" prefWidth="80" />
            <TableColumn style="-fx-alignment: CENTER-LEFT;" fx:id="colNombre" text="Producto" prefWidth="300" />
            <TableColumn style="-fx-alignment: CENTER-LEFT;" fx:id="colCosto" text="Costo" prefWidth="100" />
            <TableColumn style="-fx-alignment: CENTER;" fx:id="colEditar" text="Editar" prefWidth="100" />
            <TableColumn style="-fx-alignment: CENTER;" fx:id="colEliminar" text="Eliminar" prefWidth="100" />
        </columns>
    </TableView>
</VBox>